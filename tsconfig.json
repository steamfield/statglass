{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*",
    "packages/core/src/**/*",
    "tests/types/browser-environment.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "packages/core/src/**/*.test.ts",
    "packages/core/src/**/*.test.tsx"
  ]
}
