{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/packages/core/src/generated",
      "!**/src/desktop-transport/commands.ts",
      "!**/apps/mobile/src/theme.generated.*",
      "!**/dist",
      "!**/target",
      "!**/vendor",
      "!**/src-tauri/gen",
      "!**/public",
      "!**/plan",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/docs-site",
      "!**/apps/mobile/ios",
      "!**/apps/mobile/.expo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedImports": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva", "clsx"]
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100,
            "skipBlankLines": true
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**", "!packages/core/src/generated/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "packages/core/src/ has no React imports.",
                  "react-dom": "packages/core/src/ has no React imports.",
                  "react-dom/client": "packages/core/src/ has no React imports.",
                  "react/jsx-runtime": "packages/core/src/ has no React imports.",
                  "@tanstack/react-query": "Define query keys and fetchers in core; the hooks live in src/app/.",
                  "zustand/react": "Use zustand/vanilla in core; bind to React in src/app/.",
                  "zustand": "Use zustand/vanilla in core; bind to React in src/app/.",
                  "react-native": "packages/core/src/ runs on every app; React Native code lives in apps/mobile.",
                  "expo": "packages/core/src/ runs on every app; Expo code lives in apps/mobile.",
                  "@steamfield/ui": "packages/core/src/ owns no UI; map core values onto @steamfield/ui in the app."
                },
                "patterns": [
                  {
                    "group": ["~/**"],
                    "message": "packages/core/src/ must not import the app layer (~/)."
                  },
                  {
                    "group": ["**/app/**", "**/app"],
                    "message": "packages/core/src/ must not import the app layer through relative paths."
                  },
                  {
                    "group": [
                      "react-native/**",
                      "expo/**",
                      "expo-*",
                      "expo-*/**"
                    ],
                    "message": "packages/core/src/ runs on every app; React Native and Expo code lives in apps/mobile."
                  },
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "packages/core/src/ runs on every app; Tauri adapters live in src/desktop-transport/."
                  },
                  {
                    "group": ["@steamfield/ui/**"],
                    "message": "packages/core/src/ owns no UI; map core values onto @steamfield/ui in the app."
                  },
                  {
                    "group": ["@desktop/**"],
                    "message": "packages/core/src/ must not import the desktop adapters."
                  },
                  {
                    "group": [
                      "node:*",
                      "assert",
                      "assert/**",
                      "buffer",
                      "child_process",
                      "cluster",
                      "console",
                      "constants",
                      "crypto",
                      "dgram",
                      "diagnostics_channel",
                      "dns",
                      "dns/**",
                      "domain",
                      "events",
                      "fs",
                      "fs/**",
                      "http",
                      "http2",
                      "https",
                      "inspector",
                      "inspector/**",
                      "module",
                      "net",
                      "os",
                      "path",
                      "path/**",
                      "perf_hooks",
                      "process",
                      "punycode",
                      "querystring",
                      "readline",
                      "readline/**",
                      "repl",
                      "stream",
                      "stream/**",
                      "string_decoder",
                      "sys",
                      "timers",
                      "timers/**",
                      "tls",
                      "trace_events",
                      "tty",
                      "url",
                      "util",
                      "util/**",
                      "v8",
                      "vm",
                      "wasi",
                      "worker_threads",
                      "zlib"
                    ],
                    "message": "Browser code has no Node runtime; keep Node imports in tooling."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "packages/core/src/ runs on every app; take what you need from window as an argument.",
                  "document": "packages/core/src/ runs on every app; the DOM belongs to the desktop app.",
                  "navigator": "packages/core/src/ runs on every app; take what you need from navigator as an argument."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/desktop-transport/**",
        "!src/desktop-transport/commands.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "src/desktop-transport/ has no React imports.",
                  "react-dom": "src/desktop-transport/ has no React imports.",
                  "react-dom/client": "src/desktop-transport/ has no React imports.",
                  "react/jsx-runtime": "src/desktop-transport/ has no React imports.",
                  "@tanstack/react-query": "Define query keys and fetchers in core; the hooks live in src/app/.",
                  "zustand/react": "Use zustand/vanilla in core; bind to React in src/app/.",
                  "zustand": "Use zustand/vanilla in core; bind to React in src/app/.",
                  "react-native": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile.",
                  "expo": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile."
                },
                "patterns": [
                  {
                    "group": ["~/**"],
                    "message": "src/desktop-transport/ must not import the app layer (~/)."
                  },
                  {
                    "group": ["**/app/**", "**/app"],
                    "message": "src/desktop-transport/ must not import the app layer through relative paths."
                  },
                  {
                    "group": [
                      "react-native/**",
                      "react-native-*",
                      "react-native-*/**",
                      "expo/**",
                      "expo-*",
                      "expo-*/**",
                      "@expo/**"
                    ],
                    "message": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile."
                  },
                  {
                    "group": [
                      "node:*",
                      "assert",
                      "assert/**",
                      "buffer",
                      "child_process",
                      "cluster",
                      "console",
                      "constants",
                      "crypto",
                      "dgram",
                      "diagnostics_channel",
                      "dns",
                      "dns/**",
                      "domain",
                      "events",
                      "fs",
                      "fs/**",
                      "http",
                      "http2",
                      "https",
                      "inspector",
                      "inspector/**",
                      "module",
                      "net",
                      "os",
                      "path",
                      "path/**",
                      "perf_hooks",
                      "process",
                      "punycode",
                      "querystring",
                      "readline",
                      "readline/**",
                      "repl",
                      "stream",
                      "stream/**",
                      "string_decoder",
                      "sys",
                      "timers",
                      "timers/**",
                      "tls",
                      "trace_events",
                      "tty",
                      "url",
                      "util",
                      "util/**",
                      "v8",
                      "vm",
                      "wasi",
                      "worker_threads",
                      "zlib"
                    ],
                    "message": "Browser code has no Node runtime; keep Node imports in tooling."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "src/main.tsx", "!src/app/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@desktop/commands": "Go through @core/transport so the mock transport can stand in; generated types and constants come from @core/generated/types.",
                  "react-native": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile.",
                  "expo": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile."
                },
                "patterns": [
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "Go through @core/transport so the mock transport can stand in."
                  },
                  {
                    "group": ["@desktop/native", "@desktop/native-*"],
                    "message": "The native adapter calls Tauri directly; go through @core/transport so the mock transport can stand in."
                  },
                  {
                    "group": [
                      "react-native/**",
                      "react-native-*",
                      "react-native-*/**",
                      "expo/**",
                      "expo-*",
                      "expo-*/**",
                      "@expo/**"
                    ],
                    "message": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile."
                  },
                  {
                    "group": [
                      "node:*",
                      "assert",
                      "assert/**",
                      "buffer",
                      "child_process",
                      "cluster",
                      "console",
                      "constants",
                      "crypto",
                      "dgram",
                      "diagnostics_channel",
                      "dns",
                      "dns/**",
                      "domain",
                      "events",
                      "fs",
                      "fs/**",
                      "http",
                      "http2",
                      "https",
                      "inspector",
                      "inspector/**",
                      "module",
                      "net",
                      "os",
                      "path",
                      "path/**",
                      "perf_hooks",
                      "process",
                      "punycode",
                      "querystring",
                      "readline",
                      "readline/**",
                      "repl",
                      "stream",
                      "stream/**",
                      "string_decoder",
                      "sys",
                      "timers",
                      "timers/**",
                      "tls",
                      "trace_events",
                      "tty",
                      "url",
                      "util",
                      "util/**",
                      "v8",
                      "vm",
                      "wasi",
                      "worker_threads",
                      "zlib"
                    ],
                    "message": "Browser code has no Node runtime; keep Node imports in tooling."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/widgets/**",
        "!src/app/widgets/**/*.test.ts",
        "!src/app/widgets/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@core/transport": "Widgets are render-only: take data as props; subscribe in the route or a hook.",
                  "react-router": "Widgets take hrefs/callbacks as props.",
                  "@tanstack/react-query": "Widgets take data as props; query in the route or a hook.",
                  "zustand": "Widgets take state as props.",
                  "@desktop/commands": "Widgets take data and callbacks as props; generated types and constants come from @core/generated/types.",
                  "react-native": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile.",
                  "expo": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile."
                },
                "patterns": [
                  {
                    "group": ["@core/transport/**"],
                    "message": "Widgets are render-only: take data as props; subscribe in the route or a hook."
                  },
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "Widgets never call Tauri. Take a callback prop."
                  },
                  {
                    "group": ["zustand/**", "~/stores/**", "**/stores/**"],
                    "message": "Widgets take state as props."
                  },
                  {
                    "group": ["~/**", "!~/lib/utils", "!~/lib/motion/**"],
                    "message": "Widgets may only depend on the shared presentation utilities and motion primitives."
                  },
                  {
                    "group": ["../../**", "../*/**", "../app", "../router"],
                    "message": "Relative imports stay inside src/app/widgets; use the allowed ~/lib aliases for shared helpers."
                  },
                  {
                    "group": [
                      "@desktop/**",
                      "@core/mock-transport",
                      "@core/mock/**"
                    ],
                    "message": "Widgets are render-only: take data as props; subscribe in the route or a hook."
                  },
                  {
                    "group": [
                      "react-native/**",
                      "react-native-*",
                      "react-native-*/**",
                      "expo/**",
                      "expo-*",
                      "expo-*/**",
                      "@expo/**"
                    ],
                    "message": "The desktop app renders with React DOM; React Native and Expo belong to apps/mobile."
                  },
                  {
                    "group": [
                      "node:*",
                      "assert",
                      "assert/**",
                      "buffer",
                      "child_process",
                      "cluster",
                      "console",
                      "constants",
                      "crypto",
                      "dgram",
                      "diagnostics_channel",
                      "dns",
                      "dns/**",
                      "domain",
                      "events",
                      "fs",
                      "fs/**",
                      "http",
                      "http2",
                      "https",
                      "inspector",
                      "inspector/**",
                      "module",
                      "net",
                      "os",
                      "path",
                      "path/**",
                      "perf_hooks",
                      "process",
                      "punycode",
                      "querystring",
                      "readline",
                      "readline/**",
                      "repl",
                      "stream",
                      "stream/**",
                      "string_decoder",
                      "sys",
                      "timers",
                      "timers/**",
                      "tls",
                      "trace_events",
                      "tty",
                      "url",
                      "util",
                      "util/**",
                      "v8",
                      "vm",
                      "wasi",
                      "worker_threads",
                      "zlib"
                    ],
                    "message": "Browser code has no Node runtime; keep Node imports in tooling."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 200,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**",
        "src/app/routes/dev/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 200,
                "skipBlankLines": true
              }
            }
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 1000,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/e2e/docker-containers.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 1050,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/core/src/**/*.test.ts",
        "packages/core/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "packages/core/src/ has no React imports.",
                  "react-dom": "packages/core/src/ has no React imports.",
                  "react-dom/client": "packages/core/src/ has no React imports.",
                  "react/jsx-runtime": "packages/core/src/ has no React imports.",
                  "@tanstack/react-query": "Define query keys and fetchers in core; the hooks live in src/app/.",
                  "zustand/react": "Use zustand/vanilla in core; bind to React in src/app/.",
                  "zustand": "Use zustand/vanilla in core; bind to React in src/app/.",
                  "react-native": "packages/core/src/ runs on every app; React Native code lives in apps/mobile.",
                  "expo": "packages/core/src/ runs on every app; Expo code lives in apps/mobile.",
                  "@steamfield/ui": "packages/core/src/ owns no UI; map core values onto @steamfield/ui in the app."
                },
                "patterns": [
                  {
                    "group": ["~/**"],
                    "message": "packages/core/src/ must not import the app layer (~/)."
                  },
                  {
                    "group": ["**/app/**", "**/app"],
                    "message": "packages/core/src/ must not import the app layer through relative paths."
                  },
                  {
                    "group": [
                      "react-native/**",
                      "expo/**",
                      "expo-*",
                      "expo-*/**"
                    ],
                    "message": "packages/core/src/ runs on every app; React Native and Expo code lives in apps/mobile."
                  },
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "packages/core/src/ runs on every app; Tauri adapters live in src/desktop-transport/."
                  },
                  {
                    "group": ["@steamfield/ui/**"],
                    "message": "packages/core/src/ owns no UI; map core values onto @steamfield/ui in the app."
                  },
                  {
                    "group": ["@desktop/**"],
                    "message": "packages/core/src/ must not import the desktop adapters."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "off",
              "options": {
                "deniedGlobals": {}
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**/*.test.ts", "src/app/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "Go through @core/transport so the mock transport can stand in."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-dom": "apps/mobile renders with React Native; react-dom is desktop only.",
                  "react-dom/client": "apps/mobile renders with React Native; react-dom is desktop only."
                },
                "patterns": [
                  {
                    "group": ["react-dom/**"],
                    "message": "apps/mobile renders with React Native; react-dom is desktop only."
                  },
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "apps/mobile never calls Tauri; it talks to Rust through statglass-native."
                  },
                  {
                    "group": ["~/**", "@desktop/**"],
                    "message": "apps/mobile must not import the desktop app; shared code comes from @core/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/**", "apps/mobile/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-dom": "apps/mobile renders with React Native; react-dom is desktop only.",
                  "react-dom/client": "apps/mobile renders with React Native; react-dom is desktop only."
                },
                "patterns": [
                  {
                    "group": ["react-dom/**"],
                    "message": "apps/mobile renders with React Native; react-dom is desktop only."
                  },
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "apps/mobile never calls Tauri; it talks to Rust through statglass-native."
                  },
                  {
                    "group": ["~/**", "@desktop/**"],
                    "message": "apps/mobile must not import the desktop app; shared code comes from @core/."
                  },
                  {
                    "group": ["../**"],
                    "message": "Relative imports stay in the current directory; import other app code through @/ and shared code through @core/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-dom": "apps/mobile renders with React Native; react-dom is desktop only.",
                  "react-dom/client": "apps/mobile renders with React Native; react-dom is desktop only."
                },
                "patterns": [
                  {
                    "group": ["react-dom/**"],
                    "message": "apps/mobile renders with React Native; react-dom is desktop only."
                  },
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "apps/mobile never calls Tauri; it talks to Rust through statglass-native."
                  },
                  {
                    "group": ["~/**", "@desktop/**"],
                    "message": "apps/mobile must not import the desktop app; shared code comes from @core/."
                  },
                  {
                    "group": [
                      "../**",
                      "!../app.config",
                      "!../metro-resolve.cjs",
                      "!../scripts/*.mjs"
                    ],
                    "message": "Tests import app code through @/ and shared code through @core/; only the root configs and scripts/ are reached relatively."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
