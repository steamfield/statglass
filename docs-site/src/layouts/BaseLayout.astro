              />
            </svg>
          </a>
        </span>
        <span class="flex gap-4">
          <a href="https://steamfield.io/privacy" class="hover:text-foreground">
            Privacy
          </a>
          <a href={SITE.repo} class="hover:text-foreground">
            Source on GitHub
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
