---
import { revealGateScript } from "@steamfield/ui/reveal";
import "@/styles/global.css";
import { SITE } from "@/config";

interface Props {
  /** Page title without the site name. */
  title?: string;
  description?: string;
  /** Route path such as "/" or "/docs/install"; never Astro.url.pathname. */
  path: string;
  ogImage?: string;
  noindex?: boolean;
  /** Full-bleed sections (landing) instead of the centred content column. */
  landing?: boolean;
  /** A Markdown copy of this page, for agents (docs pages). */
  alternate?: string;
  jsonLd?: object[];
  ogType?: "website" | "article";
  article?: { published: Date; modified?: Date };
}

const {
  title,
  description = SITE.description,
  path,
  ogImage = SITE.ogImage,
  noindex = false,
  landing = false,
  alternate,
  jsonLd: graph,
  ogType = "website",
  article,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(path, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
// Escape "<" so no value can close the <script> it is inlined into.
const jsonLd = graph
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@graph": graph,
    }).replace(/</g, "\\u003c")
  : path === "/" && !noindex
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          { "@type": "WebSite", name: SITE.title, url: canonical.href },
          {
            "@type": "SoftwareApplication",
            "@id": new URL("/#app", Astro.site).href,
            name: SITE.title,
            description,
            operatingSystem: "macOS 26 or later (Apple Silicon)",
            applicationCategory: "UtilitiesApplication",
            offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
            license: `${SITE.repo}/blob/main/LICENSE`,
            downloadUrl: `${SITE.repo}/releases`,
            url: canonical.href,
          },
        ],
      }).replace(/</g, "\\u003c")
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex" : "max-snippet:-1, max-image-preview:large"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {alternate && (
      <link rel="alternate" type="text/markdown" href={alternate} />
    )}
    {path.startsWith("/blog") && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="StatGlass blog"
        href={new URL("/blog/rss.xml", Astro.site)}
      />
    )}
    {!noindex && (
      <>
        {article && (
          <>
            <meta
              property="article:published_time"
              content={article.published.toISOString()}
            />
            <meta
              property="article:modified_time"
              content={(article.modified ?? article.published).toISOString()}
            />
          </>
        )}
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE.title} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogUrl} />
        {ogImage === SITE.ogImage && (
          <>
            <meta property="og:image:type" content="image/webp" />
            <meta property="og:image:width" content="2560" />
            <meta property="og:image:height" content="1340" />
            <meta property="og:image:alt" content={SITE.ogImageAlt} />
          </>
        )}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogUrl} />
        {ogImage === SITE.ogImage && (
          <meta name="twitter:image:alt" content={SITE.ogImageAlt} />
        )}
      </>
    )}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline set:html={revealGateScript} />
    <script is:inline>
      // Follow the system appearance, as the app does; no site toggle.
      (() => {
        const system = matchMedia("(prefers-color-scheme: dark)");
        const apply = () =>
          document.documentElement.classList.toggle("dark", system.matches);
        apply();
        system.addEventListener("change", apply);
      })();
    </script>
    <script>
      import { initAnalytics, track } from "@/lib/analytics";
      import { EVENTS } from "@/lib/events";
      import {
        createConsentStore,
        mountConsentBanner,
      } from "@steamfield/ui/consent";
      import { enhanceCopyButtons } from "@steamfield/ui/copy";
      import { initReveal } from "@steamfield/ui/reveal";
      // A build without a key ships no analytics or consent code: this branch is
      // dropped. One sf-consent cookie on .steamfield.io covers every Steamfield site.
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      if (key) {
        const consent = createConsentStore({ domain: "steamfield.io" });
        initAnalytics({
          key,
          host: import.meta.env.PUBLIC_POSTHOG_HOST,
          site: "statglass",
          consent,
        });
        mountConsentBanner(consent, {
          message:
            "The StatGlass docs count visits and clicks with PostHog. Accept lets it set cookies so repeat visits count once, and turns on session recordings and heatmaps.",
          privacyHref: "https://steamfield.io/privacy",
        });
      }
      // Scroll reveals (src/styles/sf-theme.css). Without this script, or with
      // reduced motion, every section is simply visible.
      initReveal();
      enhanceCopyButtons(document, {
        messages: {
          failed: (subject, { hidden }) =>
            hidden
              ? `Copy failed. Open the ${subject} as Markdown and copy it from there.`
              : `Copy failed. The ${subject} is selected; press Cmd+C or Ctrl+C.`,
        },
      });
      for (const link of document.querySelectorAll<HTMLElement>(
        "[data-track-install]"
      )) {
        link.addEventListener("click", () =>
          track(EVENTS.downloadClicked, {
            from: link.dataset.trackInstall ?? "",
          })
        );
      }
      // The header's hairline appears once the page scrolls under it.
      const header = document.querySelector<HTMLElement>("[data-header]");
      const sentinel = document.querySelector("[data-header-sentinel]");
      if (header && sentinel) {
        new IntersectionObserver(([entry]) => {
          header.toggleAttribute("data-scrolled", !entry?.isIntersecting);
        }).observe(sentinel);
      }
    </script>
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only fixed top-3 left-4 z-50 rounded-control bg-foreground px-4 py-3 text-sm text-background focus:not-sr-only"
    >
      Skip to content
    </a>
    <div data-header-sentinel class="h-px" aria-hidden="true"></div>
    <header
      data-header
      class="sticky top-0 z-40 -mt-px border-b border-transparent bg-background/90 backdrop-blur-md backdrop-saturate-150 transition-colors duration-(--motion-fast) data-scrolled:border-border"
    >
      <div class="mx-auto flex h-14 max-w-[1200px] items-center gap-6 px-4 sm:px-8">
        <a
          href="/"
          class="-mx-1.5 flex items-center gap-2 rounded-control px-1.5 py-1 text-[15px] font-semibold tracking-[-0.01em]"
          aria-current={path === "/" ? "page" : undefined}
        >
          <img src="/favicon.svg" alt="" width="20" height="20" />
          {SITE.title}
        </a>
        <nav
          class="ml-auto flex items-center gap-1 text-[13px] font-medium"
          aria-label="Site"
        >
          {SITE.nav.map((item) => (
            <a
              href={item.href}
              class="rounded-control px-2.5 py-1.5 text-muted-foreground transition-colors duration-(--motion-fast) hover:text-foreground aria-[current]:text-foreground"
              aria-current={
                path === item.href
                  ? "page"
                  : path.startsWith(`${item.href}/`)
                    ? "true"
                    : undefined
              }
            >
              {item.label}
            </a>
          ))}
          <a
            href={SITE.repo}
            class="flex items-center gap-1.5 rounded-control px-2.5 py-1.5 text-muted-foreground transition-colors duration-(--motion-fast) hover:text-foreground"
          >
            <svg
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span class="max-sm:sr-only">GitHub</span>
          </a>
          <a
            href="/docs/install"
            data-track-install="header"
            class="ml-2 inline-flex h-8 items-center rounded-control bg-primary px-3 text-primary-foreground transition-opacity duration-(--motion-fast) hover:opacity-90"
          >
            Install
          </a>
        </nav>
      </div>
    </header>
    <main
      id="main"
      class:list={[
        "min-h-[calc(100vh-160px)]",
        !landing && "mx-auto max-w-[1200px] px-4 pt-4 pb-16 sm:px-8 sm:pb-20",
      ]}
    >
      <slot />
    </main>
    <footer class="border-t border-border text-muted-foreground">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-4 py-8 text-xs sm:px-8">
        <span>{SITE.title} is free and open source.</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap">
          Made by
          <a
            href="https://steamfield.io"
            class="hover:text-foreground"
            aria-label="Steamfield"
          >
            <svg
              viewBox="0 0 145.59 26"
              height="22"
              class="w-auto"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M0.002 12.75A13 13 0 0 1 25.998 12.75ZM0.039 14H25.961A13 13 0 0 1 25.447 16.75H0.553A13 13 0 0 1 0.039 14ZM1.221 18.5H24.779A13 13 0 0 1 23.437 20.75H2.563A13 13 0 0 1 1.221 18.5ZM4.693 23H21.307A13 13 0 0 1 4.693 23Z"
              />
              <path
                fill="currentColor"
                d="M45.795 18.191V18.02C45.795 16.506 44.94 15.382 43.205 14.869L38.881 13.623C37.929 13.354 37.684 13.134 37.684 12.597C37.684 11.864 38.466 11.375 39.663 11.375C41.3 11.375 42.106 11.962 42.13 13.159H45.428C45.38 10.374 43.23 8.688 39.688 8.688C36.341 8.688 34.264 10.374 34.264 13.086C34.264 14.698 34.704 15.577 37.147 16.335L41.227 17.605C42.082 17.874 42.375 18.142 42.375 18.509C42.375 19.315 41.422 19.633 39.834 19.633C38.271 19.633 37.44 19.339 37.147 17.923H33.8C33.898 20.805 36.023 22.32 40.03 22.32C43.743 22.32 45.795 20.854 45.795 18.191ZM53.295 22.1V19.706C52.953 19.755 52.757 19.779 52.513 19.779C51.609 19.779 51.389 19.51 51.389 18.338V11.449H53.295V9.177H51.389V5.634H47.969V9.177H46.283V11.449H47.969V19.266C47.969 21.343 49.068 22.198 51.316 22.198C52.073 22.198 52.684 22.124 53.295 22.1ZM66.047 15.993C66.047 11.449 63.751 8.688 59.866 8.688C56.08 8.688 53.759 11.253 53.759 15.675C53.759 19.901 56.055 22.32 59.793 22.32C62.749 22.32 65.143 20.976 65.9 18.387H62.529C62.236 19.339 61.161 19.706 59.915 19.706C58.303 19.706 57.277 18.973 57.179 16.408H66.023ZM62.48 14.136H57.228C57.448 12.304 58.303 11.302 59.817 11.302C61.283 11.302 62.309 12.255 62.48 14.136ZM78.872 22.1V21.685C78.262 21.123 78.091 20.756 78.091 20.072V12.743C78.091 10.056 76.259 8.688 72.692 8.688C69.125 8.688 67.268 10.203 67.049 13.257H70.347C70.518 11.888 71.079 11.449 72.765 11.449C74.084 11.449 74.744 11.888 74.744 12.768C74.744 14.16 73.718 14.014 72.008 14.307L70.64 14.551C68.026 15.015 66.755 16.139 66.755 18.533C66.755 21.098 68.563 22.32 70.762 22.32C72.228 22.32 73.571 21.685 74.768 20.439C74.768 21.123 74.842 21.709 75.159 22.1ZM74.744 16.457C74.744 18.436 73.767 19.559 72.032 19.559C70.884 19.559 70.176 19.12 70.176 18.142C70.176 17.141 70.713 16.774 72.13 16.506L73.303 16.286C74.206 16.115 74.353 16.066 74.744 15.87ZM99.051 22.1V12.768C99.051 10.203 97.488 8.688 94.849 8.688C93.188 8.688 92.016 9.274 90.99 10.643C90.354 9.397 89.035 8.688 87.398 8.688C85.88