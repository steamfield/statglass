{
  "statglass-schema": { "normal": [], "dev": [] },
  "statglass-proto": { "normal": ["statglass-schema"], "dev": [] },
  "statglass-collect": { "normal": ["statglass-schema"], "dev": [] },
  "statglass-store": {
    "normal": ["statglass-schema"],
    "dev": ["statglass-proto"]
  },
  "statglass-engine": {
    "normal": ["statglass-schema", "statglass-collect", "statglass-store"],
    "dev": ["statglass-collect", "statglass-store"]
  },
  "statglass-session": {
    "normal": [
      "statglass-schema",
      "statglass-proto",
      "statglass-store",
      "statglass-engine"
    ],
    "dev": []
  },
  "statglass-ssh": {
    "normal": ["statglass-session"],
    "dev": [
      "statglass-session",
      "statglass-schema",
      "statglass-proto",
      "statglass-engine",
      "statglass-store"
    ]
  },
  "statglass-ipc": {
    "normal": [
      "statglass-schema",
      "statglass-store",
      "statglass-engine",
      "statglass-session"
    ],
    "dev": []
  },
  "statglass-remote": {
    "normal": [
      "statglass-schema",
      "statglass-proto",
      "statglass-store",
      "statglass-engine",
      "statglass-session"
    ],
    "dev": ["statglass-session", "statglass-ssh"]
  },
  "statglass-remote-helper": { "normal": ["statglass-remote"], "dev": [] },
  "statglass-agent": {
    "normal": [
      "statglass-schema",
      "statglass-proto",
      "statglass-store",
      "statglass-engine",
      "statglass-remote",
      "statglass-update"
    ],
    "dev": ["statglass-collect"]
  },
  "statglass": {
    "normal": [
      "statglass-schema",
      "statglass-proto",
      "statglass-store",
      "statglass-engine",
      "statglass-remote",
      "statglass-update",
      "statglass-query",
      "statglass-notify",
      "statglass-ipc"
    ],
    "dev": ["statglass-remote"]
  },
  "statglass-update": { "normal": [], "dev": [] },
  "statglass-query": { "normal": ["statglass-schema"], "dev": [] },
  "statglass-notify": { "normal": ["statglass-schema"], "dev": [] },
  "statglass-mobile": {
    "normal": [
      "statglass-schema",
      "statglass-proto",
      "statglass-store",
      "statglass-engine",
      "statglass-session",
      "statglass-ipc",
      "statglass-ssh"
    ],
    "dev": ["statglass-ssh"]
  },
  "statglass-cli": {
    "normal": ["statglass-query", "statglass-schema"],
    "dev": []
  }
}
